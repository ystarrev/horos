+#ifdef LOCK_IMAGE_FILES
+class HorosDcmQueryRetrieveFileLock
+{
+public:
+    explicit HorosDcmQueryRetrieveFileLock(const char *filename)
+    : fd_(-1)
+    {
+#ifdef O_BINARY
+        fd_ = open(filename, O_RDONLY | O_BINARY);
+#else
+        fd_ = open(filename, O_RDONLY);
+#endif
+        if (fd_ >= 0)
+            dcmtk_flock(fd_, LOCK_SH);
+    }
+
+    ~HorosDcmQueryRetrieveFileLock()
+    {
+        if (fd_ >= 0) {
+            dcmtk_flock(fd_, LOCK_UN);
+            close(fd_);
+        }
+    }
+
+    OFBool isOpen() const
+    {
+        return fd_ >= 0;
+    }
+
+private:
+    int fd_;
+};
+#endif
